# Nexus API configuration — copy to .env and fill in real values.
# NEVER commit real secrets.

# HTTP listen address
ADDR=:8080

# development | staging | production. staging/production enable strict
# startup checks (secret length/placeholders, OTP_DEBUG, dev DB passwords).
APP_ENV=development

# Social/ledger/market/chat database role (no dating privileges)
DATABASE_URL=postgres://nexus_social:CHANGE_ME@127.0.0.1:5432/nexus?sslmode=disable

# Dating database role (no social privileges except friend_ids view)
DATABASE_DATING_URL=postgres://nexus_dating:CHANGE_ME@127.0.0.1:5432/nexus?sslmode=disable

# Redis (whisper TTL store, OTP store)
REDIS_ADDR=127.0.0.1:6379

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# HMAC key the payment provider uses to sign coin top-up confirmations
PAYMENT_SIGNING_KEY=CHANGE_ME_openssl_rand_hex_32

# 1 = return OTP codes in API responses (DEVELOPMENT ONLY, never in prod)
OTP_DEBUG=1

# Requests per minute per IP/user
RATE_LIMIT_PER_MIN=120

# Whisper message TTL in seconds (prototype behavior: 5s self-destruct)
WHISPER_TTL_SECONDS=5

# --- SMS OTP delivery ------------------------------------------------------
# log = development stub: logs a masked delivery line and sends nothing.
# http = POST {"to","sender_id","message"} with Authorization: Bearer <key>.
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# --- payments (Nexus Coins top-ups) ---------------------------------------
# log = development stub: creates intents without a checkout URL; confirm
# them through the signed webhook. http = charge + webhook contract (README).
PAYMENT_PROVIDER=log
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_RETURN_URL=http://localhost:3000/wallet

# Optional Sentry error reporting for the API (empty = disabled)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
