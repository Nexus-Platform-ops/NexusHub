# Nexus API configuration template. Copy to .env and fill in; every secret
# must come from the environment — there are no compiled-in fallbacks.
# Startup fails fast (config.FromEnv / config.Validate) on missing or unsafe
# values. See docs/ARCHITECTURE.md and docs/DSR_DESIGN.md.

# --- Core ---
APP_ENV=development            # development | staging | production
ADDR=:8080
DATABASE_URL=postgres://nexus_social:CHANGE_ME@db:5432/nexus?sslmode=require
DATABASE_DATING_URL=postgres://nexus_dating:CHANGE_ME@db:5432/nexus?sslmode=require
REDIS_ADDR=127.0.0.1:6379
JWT_SECRET=                    # >= 32 chars, unique per environment
PAYMENT_SIGNING_KEY=           # >= 32 chars, different from JWT_SECRET
OTP_DEBUG=0                    # 1 leaks OTP codes in responses (development ONLY)
RATE_LIMIT_PER_MIN=120
WHISPER_TTL_SECONDS=5

# --- SMS (OTP delivery) ---
SMS_PROVIDER=log               # log (development) | http
SMS_API_URL=                   # https:// aggregator endpoint (required when http)
SMS_API_KEY=
SMS_SENDER_ID=

# --- Payments (coin top-ups) ---
PAYMENT_PROVIDER=log           # log (development) | http | stripe
PAYMENT_API_URL=               # https://
PAYMENT_API_KEY=
PAYMENT_RETURN_URL=            # https:// deep link back to the app

# --- Stripe (Phase F, when PAYMENT_PROVIDER=stripe) ---
STRIPE_SECRET_KEY=             # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=         # whsec_...
STRIPE_API_BASE=               # override for testing (default: https://api.stripe.com/v1)

# --- Social login (optional; endpoints answer 503 while unconfigured) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
SOCIAL_REDIRECT_BASE=          # https:// required when FB/TikTok login enabled

# --- Sentry (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Envelope encryption at rest (Phase D) ---
# development: CRYPTO_PROVIDER=local with a base64 32-byte CRYPTO_LOCAL_KEY
# staging/production: awskms or gcpkms — local is refused by Validate.
CRYPTO_PROVIDER=local
CRYPTO_LOCAL_KEY=              # base64-encoded 32-byte key (development only)
# AWS KMS:
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KMS_KEY_ID=                    # arn:aws:kms:<region>:<account>:key/<id>
# GCP KMS (alternative; service account needs cloudkms.cryptoKeyEncrypterDecrypter):
GCP_KMS_KEY_RESOURCE=          # projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>
GCP_SERVICE_ACCOUNT_JSON=      # full service account JSON (or GOOGLE_SERVICE_ACCOUNT_JSON)

# --- Device attestation ---
# development: ATTESTATION_PROVIDER=log accepts "dev:<device>" tokens.
# staging/production: playintegrity (Android) or devicecheck (iOS). With a
# real provider, dating discovery (radar/swipe) is hard-gated on a fresh
# attestation record (30-day TTL). Full App Attest DCN (CBOR) remains a
# documented 501 stub — see docs/PENTEST_SCOPE.md.
# Nonce issues are capped at 5 per hour per device.
ATTESTATION_PROVIDER=log
GOOGLE_PLAY_PACKAGE_NAME=      # e.g. mm.nexushub.nexus_app (playintegrity)
GOOGLE_SERVICE_ACCOUNT_JSON=   # needs playintegrity verdict access
APPLE_TEAM_ID=                 # Apple Developer team id (devicecheck)
APPLE_KEY_ID=                  # DeviceCheck private key id (devicecheck)
APPLE_BUNDLE_ID=               # e.g. mm.nexushub.nexusApp (devicecheck)
APPLE_P8=                      # PEM PKCS#8 ES256 private key (.p8 contents)

# --- Transactional email (DSR flows) ---
EMAIL_PROVIDER=log             # log (development) | http
EMAIL_API_URL=                 # https://
EMAIL_API_KEY=
EMAIL_FROM=                    # "Nexus <no-reply@example.com>"

# --- Observability (Phase E) ---
# Prometheus scrape endpoint on its own admin port; scraped by the
# prometheus service in docker-compose.prod.yml.
METRICS_ADDR=:9090             # empty disables the listener
# OTel traces: set an OTLP endpoint to export (e.g. otel-collector:4318).
# Empty exporter + empty endpoint = tracing disabled (no-op provider).
OTEL_TRACES_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. otel-collector:4318
OTEL_EXPORTER_OTLP_INSECURE=0  # 1 = plain http for local collectors
