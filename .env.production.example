# Production environment. Copy to .env.production and fill every value.
# Passwords are interpolated into connection URLs, so generate URL-safe hex:
#   openssl rand -hex 32
# Never commit .env.production.

# --- database -------------------------------------------------------------
# Superuser password: used only by the db and migrate services.
POSTGRES_PASSWORD=
# Isolated API role passwords (created on first database initialisation).
NEXUS_SOCIAL_PASSWORD=
NEXUS_DATING_PASSWORD=

# --- API secrets ----------------------------------------------------------
# Two DIFFERENT keys, each at least 32 characters. Startup refuses to run
# with placeholders, short keys, reused keys or OTP_DEBUG=1.
JWT_SECRET=
PAYMENT_SIGNING_KEY=

# --- runtime --------------------------------------------------------------
RATE_LIMIT_PER_MIN=120
WHISPER_TTL_SECONDS=5

# --- SMS OTP delivery (required) ------------------------------------------
# Startup fails unless SMS_PROVIDER=http with an https endpoint, key and
# sender id. Wire contract: POST {"to","sender_id","message"} with
# Authorization: Bearer $SMS_API_KEY.
SMS_PROVIDER=http
SMS_API_URL=https://sms-aggregator.example.com/v1/send
SMS_API_KEY=
SMS_SENDER_ID=Nexus

# --- payment provider (required) ------------------------------------------
# Startup fails unless PAYMENT_PROVIDER=http with an https endpoint, key and
# return URL. Charge + signed-webhook contract: see README.
PAYMENT_PROVIDER=http
PAYMENT_API_URL=https://payments.example.com/v1/charges
PAYMENT_API_KEY=
PAYMENT_RETURN_URL=https://app.example.com/wallet

# --- public endpoint / TLS (Caddy) ---------------------------------------
# DNS A/AAAA for DOMAIN must point at this host before the first start.
# Bare hostname only — no scheme, no path.
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# Public HTTPS base of the API, baked into the Flutter web build.
NEXUS_PUBLIC_API_URL=https://app.example.com

# --- optional social logins (503 until configured) ------------------------
# Must be https:// when Facebook or TikTok is enabled.
SOCIAL_REDIRECT_BASE=https://app.example.com/api/v1/auth/social
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=

# --- error monitoring (optional) ------------------------------------------
# Backend and Flutter web usually use separate Sentry projects. Leave the
# DSNs empty to disable reporting entirely (no events leave the process).
SENTRY_DSN=
SENTRY_WEB_DSN=
SENTRY_ENVIRONMENT=production
# Git SHA or release tag shown on every event.
SENTRY_RELEASE=
# Performance tracing: 0 disables it (recommended); 0.05 samples 5%.
SENTRY_TRACES_SAMPLE_RATE=0

# --- backups (scripts/backup.sh) ------------------------------------------
BACKUP_DIR=/var/backups/nexus
BACKUP_S3_URI=s3://your-bucket/nexus
BACKUP_RETENTION_DAYS=14
# For the compose stack (db is not published on the host):
BACKUP_COMPOSE_FILE=docker-compose.prod.yml
BACKUP_COMPOSE_ENV=.env.production
