# Nexus API configuration — copy to .env and fill in real values.
# NEVER commit real secrets.

# HTTP listen address
ADDR=:8080

# Social/ledger/market/chat database role (no dating privileges)
DATABASE_URL=postgres://nexus_social:CHANGE_ME@127.0.0.1:5432/nexus?sslmode=disable

# Dating database role (no social privileges except friend_ids view)
DATABASE_DATING_URL=postgres://nexus_dating:CHANGE_ME@127.0.0.1:5432/nexus?sslmode=disable

# Redis (whisper TTL store, OTP store)
REDIS_ADDR=127.0.0.1:6379

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# HMAC key the payment provider uses to sign coin top-up confirmations
PAYMENT_SIGNING_KEY=CHANGE_ME_openssl_rand_hex_32

# 1 = return OTP codes in API responses (DEVELOPMENT ONLY, never in prod)
OTP_DEBUG=1

# Requests per minute per IP/user
RATE_LIMIT_PER_MIN=120

# Whisper message TTL in seconds (prototype behavior: 5s self-destruct)
WHISPER_TTL_SECONDS=5
