# Live 4-network SMS test — NOT committed and NOT loaded by the API at runtime.
# Fill values from the SMS aggregator account. Leave blank until available;
# the live runner refuses to start while any required value is empty.
#
# Wire contract: POST $SMS_API_URL with Authorization: Bearer $SMS_API_KEY
# and JSON {"to","sender_id","message"}. Any 2xx counts as provider-accepted.
SMS_PROVIDER=http
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# One handset per Myanmar network, E.164 format (+959...).
SMS_TEST_MPT=
SMS_TEST_OOREDOO=
SMS_TEST_ATOM=
SMS_TEST_MYTEL=

# Sends per network (1-5). Actual receipt must be confirmed by each handset.
SMS_TEST_ROUNDS=1